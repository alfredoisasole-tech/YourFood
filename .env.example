# ============================================
# YourFood / meal-app — Variables d'environnement
# ============================================
# Copier ce fichier vers .env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env dans le dépôt.

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://user:password@localhost:5432/mealapp?schema=public"

# --- Authentification JWT ---
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# --- Serveur backend ---
PORT=3001
NODE_ENV="development"

# --- Frontend ---
VITE_API_URL="http://localhost:3001/api"

# --- Timezone ---
TZ="Africa/Kinshasa"
