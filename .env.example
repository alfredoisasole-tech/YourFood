# ============================================
# YourFood / meal-app — Variables d'environnement
# ============================================
# Copier ce fichier vers apps/backend/.env et remplir les valeurs réelles.
# NE JAMAIS committer le fichier .env dans le dépôt.

# --- Base de données PostgreSQL ---
# Copier ce fichier vers apps/backend/.env.
# Si le port 5432 est déjà utilisé sur ta machine, mets POSTGRES_PORT=55432 dans un .env à la racine
# (lu par docker-compose) et utilise le même port ici.
DATABASE_URL="postgresql://user:password@localhost:5432/mealapp?schema=public"
# En production sur Supabase : utiliser l'adresse du « Session pooler » (compatible IPv4), avec
# connection_limit pour ne pas saturer la base. Voir DEPLOIEMENT.md.
# DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5"

# --- Authentification JWT ---
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# --- Serveur backend ---
PORT=3001
NODE_ENV="development"
# Origines autorisées par CORS (séparées par des virgules). Par défaut : FRONTEND_URL
# CORS_ORIGIN="https://yourfood.app"
# Nombre de proxys devant le serveur (hébergeur). Par défaut : 1 en production, 0 sinon
# TRUST_PROXY=1

# --- Tests d'intégration avec base (base dédiée, vidée à chaque test) ---
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/mealapp_test?schema=public"

# --- Frontend ---
# Adresse publique du frontend, utilisée dans les liens d'accès envoyés aux clients.
# Obligatoire en production (https://…), sinon le serveur refuse de démarrer.
FRONTEND_URL="http://localhost:5173"
VITE_API_URL="http://localhost:3001/api"

# --- Timezone ---
TZ="Africa/Kinshasa"
