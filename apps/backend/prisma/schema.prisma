// Schéma Prisma pour l'application meal-app (YourFood).
// Source de vérité : SPEC.md (Spécification finale, section 8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── UTILISATEURS ──────────────────────────────────────────────

enum Role {
  admin
  client
}

model User {
  id              Int       @id @default(autoincrement())
  nom             String    @db.VarChar(100)
  prenom          String    @db.VarChar(100)
  telephone       String?   @unique @db.VarChar(20) // Facultatif. Normalisé avec indicatif pays
  loginKey        String    @unique @map("login_key") @db.VarChar(220) // « prénom nom » sans accents ni majuscules : identifiant de connexion unique
  motDePasseHash  String?   @map("mot_de_passe_hash") @db.VarChar(255) // NULL tant que le client n'a pas créé son mot de passe
  role            Role      @default(client)
  tokenVersion    Int       @default(0) @map("token_version") // Incrémenté à chaque changement de mot de passe : invalide les sessions ouvertes
  createdAt       DateTime  @default(now()) @map("created_at")

  subscriptions   Subscription[]

  @@map("users")
}

// ─── ABONNEMENTS ───────────────────────────────────────────────

enum Formule {
  F_25000 @map("25000") // 25 000 FC — Viande lundi et vendredi uniquement
  F_35000 @map("35000") // 35 000 FC — Viande toute la semaine
}

enum StatutAbonnement {
  actif
  expire
}

model Subscription {
  id          Int               @id @default(autoincrement())
  userId      Int               @map("user_id")
  formule     Formule
  dateDebut   DateTime          @map("date_debut") @db.Date
  dateFin     DateTime          @map("date_fin") @db.Date // Calculée automatiquement (dateDebut + durée)
  bonus       String?           @db.VarChar(255) // Champ bonus non encore défini
  statut      StatutAbonnement  @default(actif)
  createdAt   DateTime          @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessCodes AccessCode[]
  orders      Order[]

  @@index([userId])
  @@index([statut])
  @@map("subscriptions")
}

// ─── CODES D'ACCÈS / ACTIVATION ────────────────────────────────

enum AccessCodeType {
  activation
  reinitialisation
}

model AccessCode {
  id              Int             @id @default(autoincrement())
  subscriptionId  Int             @map("subscription_id")
  code            String          @unique @db.VarChar(8) // 2 initiales + 6 caractères
  type            AccessCodeType
  dateGeneration  DateTime        @default(now()) @map("date_generation")
  utilise         Boolean         @default(false)
  dateUtilisation DateTime?       @map("date_utilisation")

  subscription    Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("access_codes")
}

// ─── CATALOGUE DE PLATS ────────────────────────────────────────

enum CategorieItem {
  plat
  accompagnement
  viande
}

model CatalogItem {
  id          Int            @id @default(autoincrement())
  categorie   CategorieItem
  nom         String         @db.VarChar(200)
  actif       Boolean        @default(true) // false = masqué du catalogue actif sans être supprimé
  supprime    Boolean        @default(false) // true = supprimé par l'admin mais conservé pour l'historique des jours passés
  createdAt   DateTime       @default(now()) @map("created_at")

  offerOptions OfferOption[]

  @@index([categorie])
  @@index([actif])
  @@index([supprime])
  @@map("catalog_items")
}

// ─── OFFRES DU JOUR ────────────────────────────────────────────

enum StatutOffre {
  ouvert
  verrouille
}

model DailyOffer {
  id                    Int          @id @default(autoincrement())
  date                  DateTime     @unique @db.Date
  heureLimiteIndicative String       @default("13:00") @map("heure_limite_indicative") @db.VarChar(5) // Format HH:mm
  statut                StatutOffre  @default(ouvert)

  options               OfferOption[]
  orders                Order[]

  @@index([date])
  @@map("daily_offers")
}

// ─── OPTIONS D'OFFRE (TABLE DE LIAISON) ─────────────────────────

model OfferOption {
  id            Int         @id @default(autoincrement())
  dailyOfferId  Int         @map("daily_offer_id")
  catalogItemId Int         @map("catalog_item_id")

  dailyOffer    DailyOffer  @relation(fields: [dailyOfferId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  platOrders           Order[] @relation("OrderPlat")
  accompagnementOrders Order[] @relation("OrderAccompagnement")
  viandeOrders         Order[] @relation("OrderViande")

  @@unique([dailyOfferId, catalogItemId])
  @@index([dailyOfferId])
  @@map("offer_options")
}

// ─── COMMANDES ─────────────────────────────────────────────────

enum StatutCommande {
  en_attente
  verrouillee
  annulee
}

model Order {
  id                Int             @id @default(autoincrement())
  dailyOfferId      Int             @map("daily_offer_id")
  subscriptionId    Int             @map("subscription_id")
  platId            Int?            @map("plat_id") // NULL uniquement si la commande est annulée sans choix préalable
  accompagnementId  Int?            @map("accompagnement_id") // idem
  viandeId          Int?            @map("viande_id") // NULL si la formule n'inclut pas la viande ce jour
  statut            StatutCommande  @default(en_attente)
  estDefaut         Boolean         @default(false) @map("est_defaut")
  prepare           Boolean         @default(false) // Coché par l'admin lors de la préparation
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  dailyOffer        DailyOffer      @relation(fields: [dailyOfferId], references: [id], onDelete: Cascade)
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plat              OfferOption?    @relation("OrderPlat", fields: [platId], references: [id], onDelete: Restrict)
  accompagnement    OfferOption?    @relation("OrderAccompagnement", fields: [accompagnementId], references: [id], onDelete: Restrict)
  viande            OfferOption?    @relation("OrderViande", fields: [viandeId], references: [id], onDelete: Restrict)
  review            Review?

  @@unique([dailyOfferId, subscriptionId])
  @@index([dailyOfferId])
  @@index([subscriptionId])
  @@index([statut])
  @@map("orders")
}

// ─── AVIS / NOTATION ──────────────────────────────────────────

model Review {
  id          Int       @id @default(autoincrement())
  orderId     Int       @unique @map("order_id")
  commentaire String?   @db.Text
  noteEtoile  Int?      @map("note_etoile") @db.SmallInt // 1 à 5
  rempli      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
